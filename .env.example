# 必填：DeepSeek API Key（或任何 OpenAI 兼容接口的 Key）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 置信度低于这个值，结果标记为「建议人工复核」
REVIEW_THRESHOLD=0.7
MAX_STEPS=25

# 可选：中国 8/10 位编码和退税率数据（默认 hs_agent/data/cn_tariff.csv）
CN_TARIFF_FILE=

# 在线查询海关「进出口税则商品及品目注释」，结果缓存在 agent_data/notes_cache/
NOTES_ONLINE=1
NOTES_TTL_DAYS=15
# 两次在线查询之间至少间隔的秒数
NOTES_INTERVAL_S=5
# 设为 0 可以看到浏览器一步步操作
NOTES_HEADLESS=1

# 模型价格（元/百万 token），用于估算成本，请按官方最新价格修改
PRICE_INPUT_PER_M=2
PRICE_OUTPUT_PER_M=8
